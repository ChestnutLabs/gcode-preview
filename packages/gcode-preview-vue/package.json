{
  "name": "@chestnutlabs/gcode-preview-vue",
  "version": "0.3.0",
  "description": "Thin Vue 3 integration for the Chestnut Labs G-code viewer (DD-007): useGcodePreview composable + GcodePreview component over the framework-neutral parser/renderer/progress packages.",
  "keywords": [
    "gcode",
    "3d-printing",
    "toolpath",
    "cnc",
    "chestnutlabs",
    "vue",
    "vue3",
    "component",
    "composable",
    "viewer",
    "preview"
  ],
  "author": "Chestnut Labs",
  "homepage": "https://github.com/ChestnutLabs/gcode-preview#readme",
  "bugs": "https://github.com/ChestnutLabs/gcode-preview/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChestnutLabs/gcode-preview.git",
    "directory": "packages/gcode-preview-vue"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chestnutlabs/gcode-parser": "0.3.0",
    "@chestnutlabs/gcode-renderer-three": "0.3.0",
    "@chestnutlabs/toolpath-core": "0.3.0",
    "@chestnutlabs/gcode-preview-core": "0.3.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.4.0"
  }
}
