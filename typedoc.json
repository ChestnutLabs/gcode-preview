{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/toolpath-core",
    "packages/gcode-parser",
    "packages/gcode-dialects",
    "packages/gcode-containers",
    "packages/gcode-renderer-three",
    "packages/gcode-preview-core",
    "packages/gcode-preview-vue",
    "packages/gcode-preview-react",
    "packages/gcode-preview-svelte",
    "packages/gcode-preview-element"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "excludeInternal": true,
    "excludeExternals": true
  },
  "out": "docs-site/api",
  "name": "Chestnut Labs G-code Preview — API Reference",
  "hideGenerator": true,
  "highlightLanguages": ["typescript", "javascript", "tsx", "jsx", "json", "bash", "sh", "html", "css", "vue", "svelte"],
  "navigationLinks": {
    "npm": "https://www.npmjs.com/package/@chestnutlabs/gcode-preview-element",
    "GitHub": "https://github.com/ChestnutLabs/gcode-preview"
  }
}
