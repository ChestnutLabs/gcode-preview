{
  "meta": {
    "surface": "Bambu MQTT push_status (AnyBridge bambu/profile.py) — mc_percent (job basis) + layer_num/total_layer_num",
    "notes": "Layer wins over job-basis percent; complete state; layer-count-mismatch fraction fallback; staleness.",
    "dd": "DD-006 §1.1 / §4.3 / §9"
  },
  "irSpec": {
    "layers": 5,
    "segsPerLayer": 4,
    "srcByteStart": 10,
    "srcByteStride": 100,
    "source": { "byteLength": 2010 }
  },
  "steps": [
    {
      "obs": {
        "v": 1,
        "timestampMs": 1000,
        "position": { "percent": 0.02, "percentBasis": "job", "layer": 0, "totalLayers": 5 },
        "state": "printing"
      },
      "expect": {
        "segIndex": 3,
        "basis": "layer",
        "confidence": "inferred",
        "band": [0, 3],
        "layerIndex": 0,
        "stale": false
      }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 2000,
        "position": { "percent": 0.45, "percentBasis": "job", "layer": 2, "totalLayers": 5 },
        "state": "printing"
      },
      "expect": { "segIndex": 11, "basis": "layer", "confidence": "inferred", "band": [8, 11], "layerIndex": 2 }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 3000,
        "position": { "percent": 0.98, "percentBasis": "job", "layer": 4, "totalLayers": 5 },
        "state": "printing"
      },
      "expect": { "segIndex": 19, "basis": "layer", "confidence": "inferred", "band": [16, 19], "layerIndex": 4 }
    },
    {
      "obs": { "v": 1, "timestampMs": 4000, "state": "complete" },
      "expect": { "segIndex": 19, "confidence": "known", "band": [19, 19], "layerIndex": 4 }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 5000,
        "position": { "layer": 30, "totalLayers": 50 },
        "state": "printing"
      },
      "expect": {
        "segIndex": 11,
        "basis": "layer",
        "confidence": "approximated",
        "band": [8, 12],
        "layerIndex": 2,
        "noteCodes": ["layer-count-mismatch"],
        "noteCodesAbsent": ["position-regressed"]
      }
    },
    {
      "tick": 25000,
      "expect": { "segIndex": 11, "stale": true }
    }
  ]
}
