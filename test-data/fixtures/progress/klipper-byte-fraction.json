{
  "meta": {
    "surface": "Klipper via Moonraker (AnyBridge klipper/profile.py) — virtual_sdcard.progress (byte fraction), print_stats.info layers only when SET_PRINT_STATS_INFO is emitted",
    "notes": "percent(bytes) promotion through the byte machinery; cross-check agreement and disagreement (band widening, never tier switching).",
    "dd": "DD-006 §1.1 / §4.3 (D4)"
  },
  "irSpec": {
    "layers": 3,
    "segsPerLayer": 4,
    "srcByteStart": 10,
    "srcByteStride": 100,
    "source": { "byteLength": 1210 }
  },
  "mapperOptions": { "fileSizeBytes": 1210 },
  "steps": [
    {
      "obs": {
        "v": 1,
        "timestampMs": 1000,
        "position": { "percent": 0.5, "percentBasis": "bytes" },
        "state": "printing"
      },
      "expect": {
        "segIndex": 5,
        "basis": "percent",
        "confidence": "approximated",
        "band": [4, 6],
        "layerIndex": 1
      }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 2000,
        "position": { "percent": 0.5, "percentBasis": "bytes", "layer": 1, "totalLayers": 3 },
        "state": "printing"
      },
      "expect": {
        "segIndex": 7,
        "basis": "layer",
        "confidence": "inferred",
        "band": [4, 7],
        "layerIndex": 1,
        "noteCodesAbsent": ["cross-check-disagrees"]
      }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 3000,
        "position": { "percent": 0.083, "percentBasis": "bytes", "layer": 2 },
        "state": "printing"
      },
      "expect": {
        "segIndex": 11,
        "basis": "layer",
        "confidence": "inferred",
        "band": [0, 11],
        "layerIndex": 2,
        "noteCodes": ["cross-check-disagrees"]
      }
    },
    {
      "obs": {
        "v": 1,
        "timestampMs": 4000,
        "position": { "percent": 0.99, "percentBasis": "bytes" },
        "state": "printing"
      },
      "expect": { "segIndex": 11, "basis": "percent", "confidence": "approximated", "band": [10, 11], "layerIndex": 2 }
    }
  ]
}
